# ─────────────────────────────────────────────────────────────
#  Captain Ayman — environment configuration
#  Copy to `.env` for local development. On Vercel, add these in
#  Project → Settings → Environment Variables. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon on Vercel adds DATABASE_URL + DATABASE_URL_UNPOOLED automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinetic
# DATABASE_URL_UNPOOLED=               # direct connection used for migrations (optional)

# Public base URL of the app (used in invite messages, reset links & origin checks)
APP_URL=http://localhost:3000
APP_NAME=Captain Ayman
APP_NAME_AR=كابتن أيمن

# REQUIRED in production — encrypts the site access code and signs access cookies.
# Generate with: openssl rand -hex 32   (changing it later signs everyone out of the access gate)
AUTH_SECRET=

# Enables the /setup page (create the coach account, reset the coach password or access code).
# Use a long random value and keep it private. Remove it to disable /setup entirely.
ADMIN_KEY=

# Session lifetime in days (clients stay signed in on their phones)
SESSION_TTL_DAYS=30

# Secret for the daily maintenance endpoint (/api/cron/daily). Vercel Cron sends it automatically.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# true when running behind a proxy you trust (Vercel, nginx, Fly…) so rate limits use the real client IP.
TRUST_PROXY=false

# ── Private photo storage ────────────────────────────────────
# database → photos are stored inside PostgreSQL (default; ideal for Vercel + Neon, nothing public)
# local    → files are written to STORAGE_LOCAL_DIR (self-hosting with a persistent disk)
# s3       → any S3-compatible private bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
STORAGE_DRIVER=database
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=10

# ── Seed data (development only) ─────────────────────────────
SEED_COACH_EMAIL=coach@kinetic.test
SEED_COACH_PASSWORD=CoachDemo!2026
SEED_CLIENT_PASSWORD=ClientDemo!2026
SEED_ACCESS_CODE=AYMAN-2026

# ── Optional ─────────────────────────────────────────────────
# DATABASE_SSL=true                     # managed Postgres over TLS (not needed when the URL has sslmode=require)
# DB_POOL_MAX=10
# MAIL_DRIVER=                          # wire a provider in src/server/mail.ts for reset emails
# SHOW_DEMO_LOGINS=false                # show demo credentials on the login page in production
